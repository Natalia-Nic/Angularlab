</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">CommonModule</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'@angular/common'</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">FormsModule</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'@angular/forms'</span></span><span>;

</span><span><span class="hljs-meta">@Component</span></span><span>({
  </span><span><span class="hljs-attr">selector</span></span><span>: </span><span><span class="hljs-string">'app-comments'</span></span><span>,
  </span><span><span class="hljs-attr">standalone</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span>,
  </span><span><span class="hljs-attr">imports</span></span><span>: [</span><span><span class="hljs-title class_">CommonModule</span></span><span>, </span><span><span class="hljs-title class_">FormsModule</span></span><span>],
  </span><span><span class="hljs-attr">templateUrl</span></span><span>: </span><span><span class="hljs-string">'./comments.html'</span></span><span>,

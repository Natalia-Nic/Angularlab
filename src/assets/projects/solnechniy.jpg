</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-attr">routes</span></span><span>: </span><span><span class="hljs-title class_">Routes</span></span><span> = [
  { </span><span><span class="hljs-attr">path</span></span><span>: </span><span><span class="hljs-string">''</span></span><span>, </span><span><span class="hljs-attr">component</span></span><span>: </span><span><span class="hljs-title class_">HomeComponent</span></span><span> },
  { </span><span><span class="hljs-attr">path</span></span><span>: </span><span><span class="hljs-string">'about'</span></span><span>, </span><span><span class="hljs-attr">component</span></span><span>: </span><span><span class="hljs-title class_">AboutComponent</span></span><span> },
  { </span><span><span class="hljs-attr">path</span></span><span>: </span><span><span class="hljs-string">'projects'</span></span><span>, </span><span><span class="hljs-attr">component</span></span><span>: </span><span><span class="hljs-title class_">ProjectsComponent</span></span><span> },
  { </span><span><span class="hljs-attr">path</span></span><span>: </span><span><span class="hljs-string">'contact'</span></span><span>, </span><span><span class="hljs-attr">component</span></span><span>: </span><span><span class="hljs-title class_">ContactComponent</span></span><span> },
  { </span><span><span class="hljs-attr">path</span></span><span>: </span><span><span class="hljs-string">'**'</span></span><span>, </span><span><span class="hljs-attr">redirectTo</span></span><span>: </span><span><span class="hljs-string">''</span></span><span> } </span><span><span class="hljs-comment">// для несуществующих страниц</span></span><span>
];
</span></span></code></div></div></pre>
<hr data-start="1475" data-end="1478">
<h3 data-start="1480" data-end="1518">3️⃣ Подключение маршрутов в модуле</h3>
<p data-start="1520" data-end="1564">В <code data-start="1522" data-end="1537">app.module.ts</code> нужно подключить маршруты:</p>

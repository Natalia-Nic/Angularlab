</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">AboutComponent</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'./components/about/about.component'</span></span><span>;

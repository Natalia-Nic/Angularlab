}

</span><span><span class="hljs-selector-tag">h2</span></span><span> {
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#2c3e50</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.form-group</span></span><span> {
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span>;

  </span><span><span class="hljs-selector-tag">label</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: block;
    </span><span><span class="hljs-attribute">font-weight</span></span><span>: </span><span><span class="hljs-number">600</span></span><span>;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">5px</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#555</span></span><span>;
  }

  </span><span><span class="hljs-selector-tag">input</span></span><span>,
  </span><span><span class="hljs-selector-tag">textarea</span></span><span> {
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#ccc</span></span><span>;
    </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">14px</span></span><span>;
    </span><span><span class="hljs-attribute">resize</span></span><span>: none;
    </span><span><span class="hljs-attribute">transition</span></span><span>: border-color </span><span><span class="hljs-number">0.3s</span></span><span>;
  }

  </span><span><span class="hljs-selector-tag">input</span></span><span><span class="hljs-selector-pseudo">:focus</span></span><span>,
  </span><span><span class="hljs-selector-tag">textarea</span></span><span><span class="hljs-selector-pseudo">:focus</span></span><span> {
    </span><span><span class="hljs-attribute">border-color</span></span><span>: </span><span><span class="hljs-number">#007bff</span></span><span>;
    </span><span><span class="hljs-attribute">outline</span></span><span>: none;
  }
}

</span><span><span class="hljs-selector-tag">button</span></span><span> {
  </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#007bff</span></span><span>;
  </span><span><span class="hljs-attribute">color</span></span><span>: white;
  </span><span><span class="hljs-attribute">border</span></span><span>: none;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-number">16px</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
  </span><span><span class="hljs-attribute">cursor</span></span><span>: pointer;
  </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">14px</span></span><span>;
  </span><span><span class="hljs-attribute">display</span></span><span>: block;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> auto;
  </span><span><span class="hljs-attribute">transition</span></span><span>: background-color </span><span><span class="hljs-number">0.3s</span></span><span>;

  &amp;</span><span><span class="hljs-selector-pseudo">:disabled</span></span><span> {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#ccc</span></span><span>;
    </span><span><span class="hljs-attribute">cursor</span></span><span>: not-allowed;
  }

  &amp;</span><span><span class="hljs-selector-pseudo">:hover</span></span><span><span class="hljs-selector-pseudo">:not</span></span><span>(:disabled) {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#0056b3</span></span><span>;
  }
}

</span><span><span class="hljs-selector-class">.comments-list</span></span><span> {
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">25px</span></span><span>;

  </span><span><span class="hljs-selector-class">.comment</span></span><span> {
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#f8f9fa</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-number">15px</span></span><span>;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">border-left</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span> solid </span><span><span class="hljs-number">#007bff</span></span><span>;
    </span><span><span class="hljs-attribute">transition</span></span><span>: all </span><span><span class="hljs-number">0.3s</span></span><span> ease;

    &amp;</span><span><span class="hljs-selector-class">.new-comment</span></span><span> {
      </span><span><span class="hljs-attribute">animation</span></span><span>: fadeIn </span><span><span class="hljs-number">0.5s</span></span><span> ease;
    }

    </span><span><span class="hljs-selector-tag">strong</span></span><span> {
      </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#007bff</span></span><span>;
    }

    </span><span><span class="hljs-selector-class">.time</span></span><span> {
      </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">12px</span></span><span>;
      </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#777</span></span><span>;
      </span><span><span class="hljs-attribute">margin-left</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
      </span><span><span class="hljs-attribute">float</span></span><span>: right;
    }

    </span><span><span class="hljs-selector-tag">p</span></span><span> {
      </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">5px</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
    }
  }
}

</span><span><span class="hljs-selector-class">.no-comments</span></span><span> {
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#888</span></span><span>;
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-keyword">@keyframes</span></span><span> fadeIn {
  from {
    </span><span><span class="hljs-attribute">opacity</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
    </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">translateY</span></span><span>(-</span><span><span class="hljs-number">5px</span></span><span>);
  }
  to {
    </span><span><span class="hljs-attribute">opacity</span></span><span>: </span><span><span class="hljs-number">1</span></span><span>;
    </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">translateY</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);
  }
}
</span></span></code></div></div></pre>

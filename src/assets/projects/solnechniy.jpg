    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">routerLink</span></span><span>=</span><span><span class="hljs-string">"/contact"</span></span><span>&gt;Контакты</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">routerLink</span></span><span>=</span><span><span class="hljs-string">"/comments"</span></span><span>&gt;Чат комментариев</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span></span></code></div></div></pre>
<hr data-start="679" data-end="682">
<h3 data-start="684" data-end="723">✅ Шаг 2. Добавь стили в <code data-start="712" data-end="723">home.scss</code></h3>

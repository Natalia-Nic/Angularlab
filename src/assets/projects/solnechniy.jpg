  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span>&gt;Добро пожаловать в строительную компанию «Альфа»</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Выберите раздел:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"button-group"</span></span><span>&gt;

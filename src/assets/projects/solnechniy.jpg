6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Копировать код</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-ts"><span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-attr">appConfig</span></span><span>: </span><span><span class="hljs-title class_">ApplicationConfig</span></span><span> = {
  </span><span><span class="hljs-attr">providers</span></span><span>: [
    </span><span><span class="hljs-title function_">provideBrowserGlobalErrorListeners</span></span><span>(),   </span><span><span class="hljs-comment">// обработка ошибок браузера</span></span><span>
    </span><span><span class="hljs-title function_">provideZonelessChangeDetection</span></span><span>(),       </span><span><span class="hljs-comment">// “беззонное” обновление UI — современный Angular-подход</span></span><span>
    </span><span><span class="hljs-title function_">provideRouter</span></span><span>(routes),                  </span><span><span class="hljs-comment">// подключение роутинга из app.routes.ts</span></span><span>
    </span><span><span class="hljs-title function_">provideClientHydration</span></span><span>(</span><span><span class="hljs-title function_">withEventReplay</span></span><span>()) </span><span><span class="hljs-comment">// SSR-гидратация (сервер+клиент)</span></span><span>
  ]
};
</span></span></code></div></div></pre>
<p data-start="657" data-end="794">📘 То есть твой файл уже <strong data-start="682" data-end="705">подключает маршруты</strong> из <code data-start="709" data-end="724">app.routes.ts</code><br data-start="724" data-end="727">
и полностью заменяет старые <code data-start="755" data-end="770">app.module.ts</code> и <code data-start="773" data-end="791">AppRoutingModule</code>.</p>
<hr data-start="796" data-end="799">
<h3 data-start="801" data-end="836">⚙️ Что тебе нужно делать дальше</h3>

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"logo"</span></span><span>&gt;🏠 Альфа</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- кнопка бургера / крестика --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"burger"</span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"toggleMenu()"</span></span><span>&gt;
    {{ menuOpen() ? '✖' : '☰' }}
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">nav</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"navbar"</span></span><span> [</span><span><span class="hljs-attr">class.open</span></span><span>]=</span><span><span class="hljs-string">"menuOpen()"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">routerLink</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span> </span><span><span class="hljs-attr">routerLinkActive</span></span><span>=</span><span><span class="hljs-string">"active"</span></span><span> [</span><span><span class="hljs-attr">routerLinkActiveOptions</span></span><span>]=</span><span><span class="hljs-string">"{ exact: true }"</span></span><span>
      (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"closeMenu()"</span></span><span>&gt;Главная</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">routerLink</span></span><span>=</span><span><span class="hljs-string">"/about"</span></span><span> </span><span><span class="hljs-attr">routerLinkActive</span></span><span>=</span><span><span class="hljs-string">"active"</span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"closeMenu()"</span></span><span>&gt;О компании</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">routerLink</span></span><span>=</span><span><span class="hljs-string">"/projects"</span></span><span> </span><span><span class="hljs-attr">routerLinkActive</span></span><span>=</span><span><span class="hljs-string">"active"</span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"closeMenu()"</span></span><span>&gt;Проекты</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">routerLink</span></span><span>=</span><span><span class="hljs-string">"/contact"</span></span><span> </span><span><span class="hljs-attr">routerLinkActive</span></span><span>=</span><span><span class="hljs-string">"active"</span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"closeMenu()"</span></span><span>&gt;Контакты</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">nav</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">header</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">main</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">router-outlet</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">router-outlet</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">main</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">footer</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"footer"</span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;© 2025 Строительная компания «Альфа». Все права защищены.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">footer</span></span></span><span>&gt;
</span></span></code></div></div></pre>

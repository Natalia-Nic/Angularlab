</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">FormsModule</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'@angular/forms'</span></span><span>;

</span><span><span class="hljs-meta">@Component</span></span><span>({
  </span><span><span class="hljs-attr">selector</span></span><span>: </span><span><span class="hljs-string">'app-comments'</span></span><span>,
  </span><span><span class="hljs-attr">standalone</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span>,
  </span><span><span class="hljs-attr">imports</span></span><span>: [</span><span><span class="hljs-title class_">FormsModule</span></span><span>],
  </span><span><span class="hljs-attr">templateUrl</span></span><span>: </span><span><span class="hljs-string">'./comments.html'</span></span><span>,
  </span><span><span class="hljs-attr">styleUrls</span></span><span>: [</span><span><span class="hljs-string">'./comments.scss'</span></span><span>]
})
</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Comments</span></span><span> {
  username = </span><span><span class="hljs-string">'Гость'</span></span><span>;
  commentText = </span><span><span class="hljs-string">''</span></span><span>;
  </span><span><span class="hljs-attr">comments</span></span><span>: { </span><span><span class="hljs-attr">user</span></span><span>: </span><span><span class="hljs-built_in">string</span></span><span>; </span><span><span class="hljs-attr">text</span></span><span>: </span><span><span class="hljs-built_in">string</span></span><span>; </span><span><span class="hljs-attr">time</span></span><span>: </span><span><span class="hljs-built_in">string</span></span><span> }[] = [];

  </span><span><span class="hljs-comment">// добавление комментария</span></span><span>
  </span><span><span class="hljs-title function_">addComment</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
    </span><span><span class="hljs-keyword">if</span></span><span> (!</span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">commentText</span></span><span>.</span><span><span class="hljs-title function_">trim</span></span><span>()) </span><span><span class="hljs-keyword">return</span></span><span>;

    </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">comments</span></span><span>.</span><span><span class="hljs-title function_">push</span></span><span>({
      </span><span><span class="hljs-attr">user</span></span><span>: </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">username</span></span><span>,
      </span><span><span class="hljs-attr">text</span></span><span>: </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">commentText</span></span><span>,
      </span><span><span class="hljs-attr">time</span></span><span>: </span><span><span class="hljs-keyword">new</span></span><span> </span><span><span class="hljs-title class_">Date</span></span><span>().</span><span><span class="hljs-title function_">toLocaleString</span></span><span>(</span><span><span class="hljs-string">'ru-RU'</span></span><span>, {
        </span><span><span class="hljs-attr">day</span></span><span>: </span><span><span class="hljs-string">'2-digit'</span></span><span>,
        </span><span><span class="hljs-attr">month</span></span><span>: </span><span><span class="hljs-string">'2-digit'</span></span><span>,
        </span><span><span class="hljs-attr">year</span></span><span>: </span><span><span class="hljs-string">'numeric'</span></span><span>,
        </span><span><span class="hljs-attr">hour</span></span><span>: </span><span><span class="hljs-string">'2-digit'</span></span><span>,
        </span><span><span class="hljs-attr">minute</span></span><span>: </span><span><span class="hljs-string">'2-digit'</span></span><span>
      })
    });

    </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">commentText</span></span><span> = </span><span><span class="hljs-string">''</span></span><span>;
  }

  </span><span><span class="hljs-comment">// вычисляемое свойство</span></span><span>
  </span><span><span class="hljs-keyword">get</span></span><span> </span><span><span class="hljs-title function_">inputIsEmpty</span></span><span>() {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">commentText</span></span><span>.</span><span><span class="hljs-title function_">trim</span></span><span>().</span><span><span class="hljs-property">length</span></span><span> === </span><span><span class="hljs-number">0</span></span><span>;
  }
}
</span></span></code></div></div></pre>

        </span><span><span class="hljs-attr">hour</span></span><span>: </span><span><span class="hljs-string">'2-digit'</span></span><span>,
        </span><span><span class="hljs-attr">minute</span></span><span>: </span><span><span class="hljs-string">'2-digit'</span></span><span>
      })
    });

    </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">commentText</span></span><span> = </span><span><span class="hljs-string">''</span></span><span>;

  </span><span><span class="hljs-comment">// Список курсов</span></span><span>
  courses = [
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Angular для начинающих'</span></span><span>, </span><span><span class="hljs-attr">level</span></span><span>: </span><span><span class="hljs-string">'начальный'</span></span><span>, </span><span><span class="hljs-attr">duration</span></span><span>: </span><span><span class="hljs-number">30</span></span><span>, </span><span><span class="hljs-attr">available</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span> },
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'React продвинутый'</span></span><span>, </span><span><span class="hljs-attr">level</span></span><span>: </span><span><span class="hljs-string">'продвинутый'</span></span><span>, </span><span><span class="hljs-attr">duration</span></span><span>: </span><span><span class="hljs-number">45</span></span><span>, </span><span><span class="hljs-attr">available</span></span><span>: </span><span><span class="hljs-literal">false</span></span><span> },
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Node.js — серверная разработка'</span></span><span>, </span><span><span class="hljs-attr">level</span></span><span>: </span><span><span class="hljs-string">'средний'</span></span><span>, </span><span><span class="hljs-attr">duration</span></span><span>: </span><span><span class="hljs-number">40</span></span><span>, </span><span><span class="hljs-attr">available</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span> },
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Python для анализа данных'</span></span><span>, </span><span><span class="hljs-attr">level</span></span><span>: </span><span><span class="hljs-string">'начальный'</span></span><span>, </span><span><span class="hljs-attr">duration</span></span><span>: </span><span><span class="hljs-number">25</span></span><span>, </span><span><span class="hljs-attr">available</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span> }
  ];

  </span><span><span class="hljs-comment">// выбранный фильтр</span></span><span>
  selectedLevel = </span><span><span class="hljs-string">'все'</span></span><span>;
}
</span></span></code></div></div></pre>

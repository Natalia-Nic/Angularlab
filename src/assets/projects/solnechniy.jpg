</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">RouterOutlet</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'@angular/router'</span></span><span>;

</span><span><span class="hljs-meta">@Component</span></span><span>({
  </span><span><span class="hljs-attr">selector</span></span><span>: </span><span><span class="hljs-string">'app-root'</span></span><span>,
  </span><span><span class="hljs-attr">standalone</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span>,
  </span><span><span class="hljs-attr">imports</span></span><span>: [</span><span><span class="hljs-title class_">RouterOutlet</span></span><span>],
  </span><span><span class="hljs-attr">templateUrl</span></span><span>: </span><span><span class="hljs-string">'./app.component.html'</span></span><span>,
  </span><span><span class="hljs-attr">styleUrl</span></span><span>: </span><span><span class="hljs-string">'./app.component.scss'</span></span><span>
})
</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">AppComponent</span></span><span> {}
</span></span></code></div></div></pre>

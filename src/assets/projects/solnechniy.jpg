51 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Копировать код</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-html"><span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comments-container"</span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;💬 Чат комментариев</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- имя пользователя --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"form-group"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Имя:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-comment">&lt;!-- двусторонняя привязка + привязка к атрибуту --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span>
      </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"text"</span></span><span>
      [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"username"</span></span><span>
      </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Введите имя"</span></span><span>
      [</span><span><span class="hljs-attr">attr.title</span></span><span>]=</span><span><span class="hljs-string">"'Ваше имя: ' + username"</span></span><span>
    /&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- поле ввода комментария --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"form-group"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Комментарий:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-comment">&lt;!-- двусторонняя привязка --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">textarea</span></span></span><span>
      [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"commentText"</span></span><span>
      </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Напишите комментарий..."</span></span><span>
      </span><span><span class="hljs-attr">rows</span></span><span>=</span><span><span class="hljs-string">"3"</span></span><span>
    &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">textarea</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- кнопка отправки --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
    (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"addComment()"</span></span><span>                &lt;!</span><span><span class="hljs-attr">--</span></span><span> </span><span><span class="hljs-attr">привязка</span></span><span> </span><span><span class="hljs-attr">метода</span></span><span> </span><span><span class="hljs-attr">к</span></span><span> </span><span><span class="hljs-attr">событию</span></span><span> </span><span><span class="hljs-attr">--</span></span><span>&gt;
    [disabled]="inputIsEmpty"             </span><span><span class="hljs-comment">&lt;!-- привязка свойства --&gt;</span></span><span>
    [class.btn-disabled]="inputIsEmpty"   </span><span><span class="hljs-comment">&lt;!-- привязка CSS-класса --&gt;</span></span><span>
  &gt;
    Отправить
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- список комментариев --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comments-list"</span></span><span> *</span><span><span class="hljs-attr">ngIf</span></span><span>=</span><span><span class="hljs-string">"comments.length &gt; 0"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;Комментарии:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;

    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>
      *</span><span><span class="hljs-attr">ngFor</span></span><span>=</span><span><span class="hljs-string">"let c of comments; let i = index"</span></span><span>
      </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comment"</span></span><span>
      [</span><span><span class="hljs-attr">class.new-comment</span></span><span>]=</span><span><span class="hljs-string">"i === comments.length - 1"</span></span><span>  &lt;!</span><span><span class="hljs-attr">--</span></span><span> </span><span><span class="hljs-attr">класс</span></span><span> </span><span><span class="hljs-attr">--</span></span><span>&gt;
      [style.borderColor]="c.user === 'Админ' ? 'red' : '#ccc'"  </span><span><span class="hljs-comment">&lt;!-- стиль --&gt;</span></span><span>
    &gt;
      </span><span><span class="hljs-comment">&lt;!-- односторонняя привязка данных --&gt;</span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ c.user }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"time"</span></span><span>&gt;{{ c.time }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;{{ c.text }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- демонстрация односторонней привязки DOM → компонент --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"preview"</span></span><span>&gt;👤 Текущее имя: {{ username }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span></span></code></div></div></pre>

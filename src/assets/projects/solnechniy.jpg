051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Копировать код</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-html"><span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"projects-container"</span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;{{ title }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- ngSwitch: фильтр по типу --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Фильтр по типу проекта:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">select</span></span></span><span> [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"selectedType"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">option</span></span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">"все"</span></span><span>&gt;Все</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">option</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">option</span></span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">"жилой"</span></span><span>&gt;Жилые</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">option</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">option</span></span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">"коммерческий"</span></span><span>&gt;Коммерческие</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">option</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">select</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> [</span><span><span class="hljs-attr">ngSwitch</span></span><span>]=</span><span><span class="hljs-string">"selectedType"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> *</span><span><span class="hljs-attr">ngSwitchCase</span></span><span>=</span><span><span class="hljs-string">"'все'"</span></span><span>&gt;Показаны все проекты компании</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> *</span><span><span class="hljs-attr">ngSwitchCase</span></span><span>=</span><span><span class="hljs-string">"'жилой'"</span></span><span>&gt;Показаны только жилые проекты</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> *</span><span><span class="hljs-attr">ngSwitchCase</span></span><span>=</span><span><span class="hljs-string">"'коммерческий'"</span></span><span>&gt;Показаны только коммерческие проекты</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"project-list"</span></span><span>&gt;
    </span><span><span class="hljs-comment">&lt;!-- ngFor + ngIf --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>
      *</span><span><span class="hljs-attr">ngFor</span></span><span>=</span><span><span class="hljs-string">"let p of projects"</span></span><span>
      *</span><span><span class="hljs-attr">ngIf</span></span><span>=</span><span><span class="hljs-string">"selectedType === 'все' || p.type === selectedType"</span></span><span>
      </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"project-card"</span></span><span>
      [</span><span><span class="hljs-attr">ngClass</span></span><span>]=<span class="hljs-string">"{
        done: p.status === 'выполнен',
        progress: p.status === 'в процессе',
        plan: p.status === 'проектируется'
      }"</span>
      [</span><span><span class="hljs-attr">ngStyle</span></span><span>]=<span class="hljs-string">"{
        opacity: p.ready ? '1' : '0.8',
        borderColor: p.ready ? 'green' : '#ccc'
      }"</span>
    &gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;{{ p.name }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Тип: </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ p.type }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Площадь: {{ p.area }} м²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> *</span><span><span class="hljs-attr">ngIf</span></span><span>=</span><span><span class="hljs-string">"p.ready; else notReady"</span></span><span>&gt;✅ Проект завершён</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ng-template</span></span></span><span> #</span><span><span class="hljs-attr">notReady</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;🚧 В разработке</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ng-template</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"status"</span></span><span>&gt;Статус: </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ p.status }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span></span></code></div></div></pre>

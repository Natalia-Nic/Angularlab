  </span><span><span class="hljs-comment">// список проектов</span></span><span>
  projects = [
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Жилой комплекс “Солнечный”'</span></span><span>, </span><span><span class="hljs-attr">type</span></span><span>: </span><span><span class="hljs-string">'жилой'</span></span><span>, </span><span><span class="hljs-attr">area</span></span><span>: </span><span><span class="hljs-number">15000</span></span><span>, </span><span><span class="hljs-attr">status</span></span><span>: </span><span><span class="hljs-string">'выполнен'</span></span><span>, </span><span><span class="hljs-attr">ready</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span> },
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Бизнес-центр “Орион”'</span></span><span>, </span><span><span class="hljs-attr">type</span></span><span>: </span><span><span class="hljs-string">'коммерческий'</span></span><span>, </span><span><span class="hljs-attr">area</span></span><span>: </span><span><span class="hljs-number">22000</span></span><span>, </span><span><span class="hljs-attr">status</span></span><span>: </span><span><span class="hljs-string">'в процессе'</span></span><span>, </span><span><span class="hljs-attr">ready</span></span><span>: </span><span><span class="hljs-literal">false</span></span><span> },
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Коттеджный посёлок “Рассвет”'</span></span><span>, </span><span><span class="hljs-attr">type</span></span><span>: </span><span><span class="hljs-string">'жилой'</span></span><span>, </span><span><span class="hljs-attr">area</span></span><span>: </span><span><span class="hljs-number">18000</span></span><span>, </span><span><span class="hljs-attr">status</span></span><span>: </span><span><span class="hljs-string">'проектируется'</span></span><span>, </span><span><span class="hljs-attr">ready</span></span><span>: </span><span><span class="hljs-literal">false</span></span><span> },
    { </span><span><span class="hljs-attr">name</span></span><span>: </span><span><span class="hljs-string">'Торговый центр “Вега”'</span></span><span>, </span><span><span class="hljs-attr">type</span></span><span>: </span><span><span class="hljs-string">'коммерческий'</span></span><span>, </span><span><span class="hljs-attr">area</span></span><span>: </span><span><span class="hljs-number">30000</span></span><span>, </span><span><span class="hljs-attr">status</span></span><span>: </span><span><span class="hljs-string">'выполнен'</span></span><span>, </span><span><span class="hljs-attr">ready</span></span><span>: </span><span><span class="hljs-literal">true</span></span><span> },
  ];

  selectedType = </span><span><span class="hljs-string">'все'</span></span><span>;
  sortBy = </span><span><span class="hljs-string">''</span></span><span>;

  </span><span><span class="hljs-comment">// фильтр по типу</span></span><span>
  </span><span><span class="hljs-title function_">filterProjects</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">projects</span></span><span>.</span><span><span class="hljs-title function_">filter</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">p</span></span></span><span> =&gt;
      </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">selectedType</span></span><span> === </span><span><span class="hljs-string">'все'</span></span><span> ? </span><span><span class="hljs-literal">true</span></span><span> : p.</span><span><span class="hljs-property">type</span></span><span> === </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">selectedType</span></span><span>
    );
  }

  </span><span><span class="hljs-comment">// сортировка по критерию</span></span><span>
  </span><span><span class="hljs-title function_">sortProjects</span></span><span>(</span><span><span class="hljs-params">criteria: <span class="hljs-built_in">string</span></span></span><span>) {
    </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">sortBy</span></span><span> = criteria;
    </span><span><span class="hljs-variable language_">this</span></span><span>.</span><span><span class="hljs-property">projects</span></span><span>.</span><span><span class="hljs-title function_">sort</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">a, b</span></span></span><span>) =&gt; {
      </span><span><span class="hljs-keyword">switch</span></span><span> (criteria) {
        </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">'area'</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> b.</span><span><span class="hljs-property">area</span></span><span> - a.</span><span><span class="hljs-property">area</span></span><span>;
        </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">'type'</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> a.</span><span><span class="hljs-property">type</span></span><span>.</span><span><span class="hljs-title function_">localeCompare</span></span><span>(b.</span><span><span class="hljs-property">type</span></span><span>);
        </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">'status'</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> a.</span><span><span class="hljs-property">status</span></span><span>.</span><span><span class="hljs-title function_">localeCompare</span></span><span>(b.</span><span><span class="hljs-property">status</span></span><span>);
        </span><span><span class="hljs-attr">default</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
      }
    });
  }
}
</span></span></code></div></div></pre>

  </span><span><span class="hljs-attribute">max-width</span></span><span>: </span><span><span class="hljs-number">600px</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">40px</span></span><span> auto;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#f8f8f8</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">16px</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">12px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.1</span></span><span>);
}

</span><span><span class="hljs-selector-class">.comment-form</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">flex-direction</span></span><span>: column;
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;

  </span><span><span class="hljs-selector-tag">input</span></span><span>,
  </span><span><span class="hljs-selector-tag">textarea</span></span><span> {
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#ccc</span></span><span>;
    </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">16px</span></span><span>;
  }

  </span><span><span class="hljs-selector-tag">button</span></span><span> {
    </span><span><span class="hljs-attribute">align-self</span></span><span>: flex-end;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#007bff</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
    </span><span><span class="hljs-attribute">font-weight</span></span><span>: bold;
    </span><span><span class="hljs-attribute">border</span></span><span>: none;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    </span><span><span class="hljs-attribute">cursor</span></span><span>: pointer;
    </span><span><span class="hljs-attribute">transition</span></span><span>: </span><span><span class="hljs-number">0.3s</span></span><span>;
  }

  </span><span><span class="hljs-selector-tag">button</span></span><span><span class="hljs-selector-attr">[disabled]</span></span><span> {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#aaa</span></span><span>;
    </span><span><span class="hljs-attribute">cursor</span></span><span>: not-allowed;
  }

  </span><span><span class="hljs-selector-tag">button</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span><span class="hljs-selector-pseudo">:not</span></span><span>([disabled]) {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#0056b3</span></span><span>;
  }
}

</span><span><span class="hljs-selector-class">.comment-list</span></span><span> {
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;

  </span><span><span class="hljs-selector-class">.comment</span></span><span> {
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-number">15px</span></span><span>;
    </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">border-left</span></span><span>: </span><span><span class="hljs-number">5px</span></span><span> solid transparent;
    </span><span><span class="hljs-attribute">transition</span></span><span>: </span><span><span class="hljs-number">0.3s</span></span><span>;

    &amp;</span><span><span class="hljs-selector-class">.new-comment</span></span><span> {
      </span><span><span class="hljs-attribute">border-left-color</span></span><span>: </span><span><span class="hljs-number">#007bff</span></span><span>;
      </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#e9f3ff</span></span><span>;
    }

    </span><span><span class="hljs-selector-class">.time</span></span><span> {
      </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">12px</span></span><span>;
      </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#777</span></span><span>;
      </span><span><span class="hljs-attribute">margin-left</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    }

    </span><span><span class="hljs-selector-tag">p</span></span><span> {
      </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">5px</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
      </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span>;
    }
  }
}
</span></span></code></div></div></pre>
<hr data-start="3587" data-end="3590">
<h2 data-start="3592" data-end="3618">🧠 Проверим требования:</h2>
<div class="_tableContainer_1rjym_1"><div tabindex="-1" class="group _tableWrapper_1rjym_13 flex w-fit flex-col-reverse"><table data-start="3620" data-end="4049" class="w-fit min-w-(--thread-content-width)"><thead data-start="3620" data-end="3661"><tr data-start="3620" data-end="3661"><th data-start="3620" data-end="3635" data-col-size="sm">Вид привязки</th><th data-start="3635" data-end="3651" data-col-size="sm">Пример в коде</th><th data-start="3651" data-end="3661" data-col-size="sm">Статус</th></tr></thead><tbody data-start="3707" data-end="4049"><tr data-start="3707" data-end="3760"><td data-start="3707" data-end="3738" data-col-size="sm">Односторонняя (DOM → данные)</td><td data-start="3738" data-end="3755" data-col-size="sm"><code data-start="3740" data-end="3754">{{ c.user }}</code></td><td data-start="3755" data-end="3760" data-col-size="sm">✅</td></tr><tr data-start="3761" data-end="3816"><td data-start="3761" data-end="3781" data-col-size="sm">Привязка свойства</td><td data-start="3781" data-end="3811" data-col-size="sm"><code data-start="3783" data-end="3810">[disabled]="inputIsEmpty"</code></td><td data-start="3811" data-end="3816" data-col-size="sm">✅</td></tr><tr data-start="3817" data-end="3862"><td data-start="3817" data-end="3830" data-col-size="sm">Событийная</td><td data-start="3830" data-end="3857" data-col-size="sm"><code data-start="3832" data-end="3856">(click)="addComment()"</code></td><td data-start="3857" data-end="3862" data-col-size="sm">✅</td></tr><tr data-start="3863" data-end="3913"><td data-start="3863" data-end="3878" data-col-size="sm">Двусторонняя</td><td data-start="3878" data-end="3908" data-col-size="sm"><code data-start="3880" data-end="3907">[(ngModel)]="commentText"</code></td><td data-start="3908" data-end="3913" data-col-size="sm">✅</td></tr><tr data-start="3914" data-end="3956"><td data-start="3914" data-end="3934" data-col-size="sm">Привязка атрибута</td><td data-start="3934" data-end="3951" data-col-size="sm"><code data-start="3936" data-end="3950">[attr.title]</code></td><td data-start="3951" data-end="3956" data-col-size="sm">✅</td></tr><tr data-start="3957" data-end="4008"><td data-start="3957" data-end="3979" data-col-size="sm">Привязка класса CSS</td><td data-start="3979" data-end="4003" data-col-size="sm"><code data-start="3981" data-end="4002">[class.new-comment]</code></td><td data-start="4003" data-end="4008" data-col-size="sm">✅</td></tr><tr data-start="4009" data-end="4049"><td data-start="4009" data-end="4026" data-col-size="sm">Привязка стиля</td><td data-start="4026" data-end="4044" data-col-size="sm"><code data-start="4028" data-end="4043">[style.color]</code></td><td data-start="4044" data-end="4049" data-col-size="sm">✅</td></tr></tbody></table><div class="sticky h-0 select-none end-(--thread-content-margin) self-end"><div class="absolute end-0 flex items-end"><span class="" data-state="closed"><button aria-label="Копировать таблицу" class="hover:bg-token-bg-tertiary text-token-text-secondary my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L
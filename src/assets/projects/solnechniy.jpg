</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">AboutComponent</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'./components/about/about.component'</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">ProjectsComponent</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'./components/projects/projects.component'</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">ContactComponent</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'./components/contact/contact.component'</span></span><span>;

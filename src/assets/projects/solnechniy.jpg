  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;💬 Чат комментариев</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comment-form"</span></span><span>&gt;
    </span><span><span class="hljs-comment">&lt;!-- Привязка к атрибуту (title) --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span>
      [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"username"</span></span><span>
      </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Введите имя"</span></span><span>
      [</span><span><span class="hljs-attr">attr.title</span></span><span>]=</span><span><span class="hljs-string">"'Ваше имя: ' + username"</span></span><span>
    /&gt;

    </span><span><span class="hljs-comment">&lt;!-- Двусторонняя привязка + placeholder --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">textarea</span></span></span><span>
      [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"commentText"</span></span><span>
      </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Введите комментарий..."</span></span><span>
    &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">textarea</span></span></span><span>&gt;

    </span><span><span class="hljs-comment">&lt;!-- Привязка свойства и события --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"addComment()"</span></span><span> [</span><span><span class="hljs-attr">disabled</span></span><span>]=</span><span><span class="hljs-string">"inputIsEmpty"</span></span><span>&gt;Отправить</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comment-list"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> *</span><span><span class="hljs-attr">ngIf</span></span><span>=</span><span><span class="hljs-string">"comments.length === 0"</span></span><span>&gt;Комментариев пока нет 😔</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;

    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>
      *</span><span><span class="hljs-attr">ngFor</span></span><span>=</span><span><span class="hljs-string">"let c of comments; let i = index"</span></span><span>
      </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comment"</span></span><span>
      [</span><span><span class="hljs-attr">class.new-comment</span></span><span>]=</span><span><span class="hljs-string">"i === comments.length - 1"</span></span><span>
    &gt;
      </span><span><span class="hljs-comment">&lt;!-- Привязка данных (интерполяция) --&gt;</span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ c.user }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"time"</span></span><span>&gt;{{ c.time }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;

      </span><span><span class="hljs-comment">&lt;!-- Привязка к стилю (динамический цвет текста) --&gt;</span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> [</span><span><span class="hljs-attr">style.color</span></span><span>]=</span><span><span class="hljs-string">"c.user === 'Админ' ? 'red' : 'black'"</span></span><span>&gt;
        {{ c.text }}
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span></span></code></div></div></pre>

  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">80px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">linear-gradient</span></span><span>(</span><span><span class="hljs-number">135deg</span></span><span>, </span><span><span class="hljs-number">#0059b3</span></span><span>, </span><span><span class="hljs-number">#0099ff</span></span><span>);
  </span><span><span class="hljs-attribute">color</span></span><span>: white;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">12px</span></span><span>;

  </span><span><span class="hljs-selector-tag">h1</span></span><span> {
    </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">2.5rem</span></span><span>;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span>;
  }

  </span><span><span class="hljs-selector-class">.cta-buttons</span></span><span> {
    </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">2rem</span></span><span>;
    </span><span><span class="hljs-attribute">display</span></span><span>: flex;
    </span><span><span class="hljs-attribute">justify-content</span></span><span>: center;
    </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span>;

    </span><span><span class="hljs-selector-class">.btn</span></span><span> {
      </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#ffcc00</span></span><span>;
      </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#003366</span></span><span>;
      </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
      </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
      </span><span><span class="hljs-attribute">text-decoration</span></span><span>: none;
      </span><span><span class="hljs-attribute">font-weight</span></span><span>: </span><span><span class="hljs-number">600</span></span><span>;
      </span><span><span class="hljs-attribute">transition</span></span><span>: </span><span><span class="hljs-number">0.3s</span></span><span>;

      &amp;</span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
        </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#ffd633</span></span><span>;
      }

      &amp;</span><span><span class="hljs-selector-class">.btn-outline</span></span><span> {
        </span><span><span class="hljs-attribute">background</span></span><span>: transparent;
        </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">2px</span></span><span> solid </span><span><span class="hljs-number">#ffcc00</span></span><span>;
        </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#ffcc00</span></span><span>;

        &amp;</span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
          </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#ffcc00</span></span><span>;
          </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#003366</span></span><span>;
        }
      }
    }
  }
}
</span></span></code></div></div></pre>
<hr data-start="3100" data-end="3103">
<h2 data-start="3105" data-end="3135">🔹 Шаг 4. Проверь навигацию</h2>
<p data-start="3136" data-end="3206">После сохранения всех файлов, сайт автоматически обновится.<br data-start="3195" data-end="3198">
Проверь:</p>
<ul data-start="3207" data-end="3338">
<li data-start="3207" data-end="3243">
<p data-start="3209" data-end="3243">“Главная” открывает приветствие.</p>
</li>
<li data-start="3244" data-end="3295">
<p data-start="3246" data-end="3295">“О компании”, “Проекты”, “Контакты” — работают.</p>
</li>
<li data-start="3296" data-end="3338">
<p data-start="3298" data-end="3338">“Не существующий путь” → страница 404.</p>
</li>
</ul>
<hr data-start="3340" data-end="3343">
<h2 data-start="3345" data-end="3393">🔹 Шаг 5. (по желанию) — Добавим адаптивность</h2>
<p data-start="3394" data-end="3568" data-is-last-node="" data-is-only-node="">Хочешь, я помогу сделать, чтобы меню красиво перестраивалось на телефонах (бургер-меню)?<br data-start="3482" data-end="3485">
Это добавит современный вид и можно сделать без библиотек — чисто на CSS и Angular.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Копировать" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.634
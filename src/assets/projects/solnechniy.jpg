 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Копировать код</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-ts"><span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">RouterModule</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'@angular/router'</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { routes } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">'./app.routes'</span></span><span>;

</span><span><span class="hljs-meta">@NgModule</span></span><span>({
  </span><span><span class="hljs-attr">imports</span></span><span>: [
    </span><span><span class="hljs-title class_">BrowserModule</span></span><span>,
    </span><span><span class="hljs-title class_">RouterModule</span></span><span>.</span><span><span class="hljs-title function_">forRoot</span></span><span>(routes)
  ],
  </span><span><span class="hljs-attr">declarations</span></span><span>: [
    </span><span><span class="hljs-title class_">AppComponent</span></span><span>,
    </span><span><span class="hljs-title class_">Home</span></span><span>,
    </span><span><span class="hljs-title class_">About</span></span><span>,
    </span><span><span class="hljs-title class_">Projects</span></span><span>,
    </span><span><span class="hljs-title class_">Contact</span></span><span>
  ],
  </span><span><span class="hljs-attr">bootstrap</span></span><span>: [</span><span><span class="hljs-title class_">AppComponent</span></span><span>]
})
</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">AppModule</span></span><span> { }
</span></span></code></div></div></pre>
<ol start="2" data-start="1119" data-end="1264">
<li data-start="1119" data-end="1264">
<p data-start="1122" data-end="1264">Убедиться, что в <code data-start="1139" data-end="1159">app.component.html</code> есть <code data-start="1165" data-end="1198">&lt;router-outlet&gt;&lt;/router-outlet&gt;</code> — это место, где будут отображаться все компоненты при навигации.</p>
</li>
</ol>
<p data-start="1266" data-end="1294">Пример <code data-start="1273" data-end="1293">app.component.html</code>:</p>
<pre class="overflow-visible!" data-start="1296" data-end="1339"><div class="contain-inline-size rounded-2xl relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl">html</div><div class="sticky top-9"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Копировать"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-sm"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.0804 16.3881 12.3148 16.1351 12.4688 15.833L12.5244 15.7031C12.5759 15.5594 12.6137 15.3698 12.6367 15.0879C12.6681 14.7044 12.668 14.211 12.668 13.5V10.667ZM13.998 12.665C14.4528 12.6634 14.8011 12.6602 15.0879 12.6367C15.4635 12.606 15.675 12.5492 15.833 12.4688L15.959 12.3975C16.2466 12.2211 16.4808 11.9
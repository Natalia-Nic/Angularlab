  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;💬 Чат комментариев</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- имя пользователя --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"form-group"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Имя:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"text"</span></span><span> [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"username"</span></span><span> </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Введите имя"</span></span><span> /&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- поле ввода комментария --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"form-group"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Комментарий:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">textarea</span></span></span><span>
      [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"commentText"</span></span><span>
      </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Напишите комментарий..."</span></span><span>
      </span><span><span class="hljs-attr">rows</span></span><span>=</span><span><span class="hljs-string">"3"</span></span><span>
    &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">textarea</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- кнопка отправки --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"addComment()"</span></span><span> [</span><span><span class="hljs-attr">disabled</span></span><span>]=</span><span><span class="hljs-string">"inputIsEmpty"</span></span><span>&gt;Отправить</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;

  </span><span><span class="hljs-comment">&lt;!-- список комментариев --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comments-list"</span></span><span> *</span><span><span class="hljs-attr">ngIf</span></span><span>=</span><span><span class="hljs-string">"comments.length &gt; 0"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;Комментарии:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> *</span><span><span class="hljs-attr">ngFor</span></span><span>=</span><span><span class="hljs-string">"let c of comments"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"comment"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ c.user }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"time"</span></span><span>&gt;{{ c.time }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;{{ c.text }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"no-comments"</span></span><span> *</span><span><span class="hljs-attr">ngIf</span></span><span>=</span><span><span class="hljs-string">"comments.length === 0"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Пока нет комментариев 😔</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span></span></code></div></div></pre>

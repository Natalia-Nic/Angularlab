051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Копировать код</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-scss"><span><span><span class="hljs-selector-class">.projects-container</span></span><span> {
  </span><span><span class="hljs-attribute">max-width</span></span><span>: </span><span><span class="hljs-number">1100px</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">40px</span></span><span> auto;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">16px</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">2px</span></span><span> </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.1</span></span><span>);
}

select {
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.project-list</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: grid;
  </span><span><span class="hljs-attribute">grid-template-columns</span></span><span>: </span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit, </span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">320px</span></span><span>, </span><span><span class="hljs-number">1</span></span><span>fr));
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.project-card</span></span><span> {
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#f9f9f9</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">14px</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">3px</span></span><span> </span><span><span class="hljs-number">6px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.08</span></span><span>);
  </span><span><span class="hljs-attribute">transition</span></span><span>: transform </span><span><span class="hljs-number">0.2s</span></span><span> ease, box-shadow </span><span><span class="hljs-number">0.2s</span></span><span> ease;
  </span><span><span class="hljs-attribute">border</span></span><span>: none;

  &amp;</span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
    </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">translateY</span></span><span>(-</span><span><span class="hljs-number">4px</span></span><span>);
    </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">5px</span></span><span> </span><span><span class="hljs-number">12px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.15</span></span><span>);
  }

  &amp;</span><span><span class="hljs-selector-class">.done</span></span><span> {
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#e8f8ec</span></span><span>;
  }

  &amp;</span><span><span class="hljs-selector-class">.progress</span></span><span> {
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#fff6e0</span></span><span>;
  }

  &amp;</span><span><span class="hljs-selector-class">.plan</span></span><span> {
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#f3f3f3</span></span><span>;
  }

  </span><span><span class="hljs-selector-class">.project-image</span></span><span> {
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">180px</span></span><span>;
    </span><span><span class="hljs-selector-tag">object</span></span><span>-fit: cover;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
  }

  </span><span><span class="hljs-selector-tag">h3</span></span><span> {
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#2c3e50</span></span><span>;
  }

  </span><span><span class="hljs-selector-class">.details</span></span><span> {
    </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">14px</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#555</span></span><span>;
    </span><span><span class="hljs-attribute">list-style</span></span><span>: none;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;

    </span><span><span class="hljs-selector-tag">li</span></span><span> {
      </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span>;
    }
  }
}
</span></span></code></div></div></pre>

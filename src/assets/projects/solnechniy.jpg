  </span><span><span class="hljs-attribute">max-width</span></span><span>: </span><span><span class="hljs-number">1000px</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">40px</span></span><span> auto;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">16px</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.1</span></span><span>);

  </span><span><span class="hljs-selector-tag">h2</span></span><span> {
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#2c3e50</span></span><span>;
  }

  select {
    </span><span><span class="hljs-attribute">display</span></span><span>: block;
    </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span> auto </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
    </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#ccc</span></span><span>;
  }

  </span><span><span class="hljs-selector-class">.project-list</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: flex;
    </span><span><span class="hljs-attribute">flex-wrap</span></span><span>: wrap;
    </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">justify-content</span></span><span>: center;
  }

  </span><span><span class="hljs-selector-class">.project-card</span></span><span> {
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">280px</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span>;
    </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">2px</span></span><span> solid </span><span><span class="hljs-number">#ccc</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">12px</span></span><span>;
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#f8f9fa</span></span><span>;
    </span><span><span class="hljs-attribute">transition</span></span><span>: all </span><span><span class="hljs-number">0.3s</span></span><span> ease;

    &amp;</span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
      </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">scale</span></span><span>(</span><span><span class="hljs-number">1.05</span></span><span>);
      </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">4px</span></span><span> </span><span><span class="hljs-number">12px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.15</span></span><span>);
    }

    </span><span><span class="hljs-selector-class">.project-img</span></span><span> {
      </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
      </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">160px</span></span><span>;
      </span><span><span class="hljs-selector-tag">object</span></span><span>-fit: cover;
      </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
      </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    }

    &amp;</span><span><span class="hljs-selector-class">.done</span></span><span> {
      </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#e8f5e9</span></span><span>;
      </span><span><span class="hljs-attribute">border-color</span></span><span>: </span><span><span class="hljs-number">#4caf50</span></span><span>;
    }

    &amp;</span><span><span class="hljs-selector-class">.progress</span></span><span> {
      </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#fff3e0</span></span><span>;
      </span><span><span class="hljs-attribute">border-color</span></span><span>: </span><span><span class="hljs-number">#ff9800</span></span><span>;
    }

    &amp;</span><span><span class="hljs-selector-class">.plan</span></span><span> {
      </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#e3f2fd</span></span><span>;
      </span><span><span class="hljs-attribute">border-color</span></span><span>: </span><span><span class="hljs-number">#2196f3</span></span><span>;
    }

    </span><span><span class="hljs-selector-class">.tech-info</span></span><span> {
      </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
      </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
      </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span> </span><span><span class="hljs-number">10px</span></span><span>;
      </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;

      </span><span><span class="hljs-selector-tag">h4</span></span><span> {
        </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">5px</span></span><span>;
        </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">14px</span></span><span>;
        </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#333</span></span><span>;
      }

      </span><span><span class="hljs-selector-tag">ul</span></span><span> {
        </span><span><span class="hljs-attribute">list-style</span></span><span>: none;
        </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
        </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;

        </span><span><span class="hljs-selector-tag">li</span></span><span> {
          </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">13px</span></span><span>;
          </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span>;
        }
      }
    }

    </span><span><span class="hljs-selector-class">.status</span></span><span> {
      </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
      </span><span><span class="hljs-attribute">font-weight</span></span><span>: </span><span><span class="hljs-number">500</span></span><span>;
      </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#555</span></span><span>;
      </span><span><span class="hljs-attribute">text-align</span></span><span>: right;
    }
  }
}
</span></span></code></div></div></pre>
<hr data-start="5667" data-end="5670">
<h2 data-start="5672" data-end="5693">✅ Что теперь есть:</h2>
<ul data-start="5694" data-end="5932">
<li data-start="5694" data-end="5726">
<p data-start="5696" data-end="5726">Красивая карточка проекта 🏗</p>
</li>
<li data-start="5727" data-end="5743">
<p data-start="5729" data-end="5743">Фото (<code data-start="5735" data-end="5740">img</code>)</p>
</li>
<li data-start="5744" data-end="5773">
<p data-start="5746" data-end="5773">Технические данные (<code data-start="5766" data-end="5770">ul</code>)</p>
</li>
<li data-start="5774" data-end="5808">
<p data-start="5776" data-end="5808">Цветовое оформление по статусу</p>
</li>
<li data-start="5809" data-end="5844">
<p data-start="5811" data-end="5844">Динамическая фильтрация по типу</p>
</li>
<li data-start="5845" data-end="5932">
<p data-start="5847" data-end="5932">Используются все нужные директивы (<code data-start="5882" data-end="5888">@for</code>, <code data-start="5890" data-end="5895">@if</code>, <code data-start="5897" data-end="5906">ngClass</code>, <code data-start="5908" data-end="5917">ngStyle</code>, <code data-start="5919" data-end="5929">ngSwitch</code>)</p>
</li>
</ul>
<hr data-start="5934" data-end="5937">
<p data-start="5939" data-end="6099" data-is-last-node="" data-is-only-node="">Хочешь, я добавлю плавную анимацию появления карточек (через <code data-start="6000" data-end="6012">@keyframes</code> fadeIn)?<br data-start="6021" data-end="6024">
Это сделает страницу ещё эффектнее, но всё останется в рамках лабораторной.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Копировать" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.2968
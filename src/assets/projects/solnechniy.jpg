  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;💬 Комментарии</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> [</span><span><span class="hljs-attr">attr.title</span></span><span>]=</span><span><span class="hljs-string">"'Пользователь: ' + username"</span></span><span>&gt;
    Пользователь: </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ username }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span>
    </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"text"</span></span><span>
    </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Введите имя"</span></span><span>
    [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"username"</span></span><span>
    </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"username-input"</span></span><span>
  /&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"messages"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> *</span><span><span class="hljs-attr">ngFor</span></span><span>=</span><span><span class="hljs-string">"let msg of comments"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"message"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;{{ msg.user }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt;:
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>&gt;{{ msg.text }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">small</span></span></span><span>&gt;{{ msg.time }}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">small</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">textarea</span></span></span><span>
    [(</span><span><span class="hljs-attr">ngModel</span></span><span>)]=</span><span><span class="hljs-string">"commentText"</span></span><span>
    [</span><span><span class="hljs-attr">class.empty</span></span><span>]=</span><span><span class="hljs-string">"inputIsEmpty"</span></span><span>
    [</span><span><span class="hljs-attr">style.borderColor</span></span><span>]=</span><span><span class="hljs-string">"inputIsEmpty ? 'red' : '#ccc'"</span></span><span>
    </span><span><span class="hljs-attr">placeholder</span></span><span>=</span><span><span class="hljs-string">"Введите комментарий..."</span></span><span>
  &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">textarea</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> (</span><span><span class="hljs-attr">click</span></span><span>)=</span><span><span class="hljs-string">"addComment()"</span></span><span> [</span><span><span class="hljs-attr">disabled</span></span><span>]=</span><span><span class="hljs-string">"inputIsEmpty"</span></span><span>&gt;
    Отправить
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span></span></code></div></div></pre>
